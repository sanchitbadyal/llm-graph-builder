profile:
  id: order-to-cash-selected
  ontology_artifact: order-to-cash
  description: >-
    Order-to-cash context: credit check, discount approval, invoicing and escalation.
    Only the explicitly selected classes are sent to the LLM; parents appear as context only.
  include_ancestors: true

groups:
  order_to_cash:
    - label: Credit Check
      iri: http://example.org/ontology/order-to-cash#CreditCheck
      parent: Manufacturing Assessment
      maps_to_business: Assessment
      definition: "A check of a customer's credit on an order, with an outcome of Pass, Hold or Reject."
    - label: Discount Approval
      iri: http://example.org/ontology/order-to-cash#DiscountApproval
      parent: Order Approval
      maps_to_business: Approval
      definition: "An approval of a discount on an order, at a tier that decides which role must authorize it."
    - label: Invoice
      iri: http://example.org/ontology/order-to-cash#Invoice
      parent: Billing Document
      maps_to_business: Invoice
      definition: "A bill sent to the customer for an order, with payment terms and currency."
    - label: Escalation Path
      iri: http://example.org/ontology/order-to-cash#EscalationPath
      parent: Manufacturing Procedure
      maps_to_business: Procedure
      definition: "The steps and roles to follow when an exceptional scenario occurs, with a resolution time target."

relationships:
  - label: approved
    type: APPROVED
    iri: http://example.org/ontology/order-to-cash#APPROVED
    domain: "Person"
    range: "Discount Approval"
    ends_defined_in_other_files: {Person: manufacturing}
    sub_property_of: approves
  - label: approved by
    type: APPROVED_BY
    iri: http://example.org/ontology/order-to-cash#APPROVED_BY
    domain: "Discount Approval"
    range: "Person"
    ends_defined_in_other_files: {Person: manufacturing}
  - label: authorized as
    type: AUTHORIZED_AS
    iri: http://example.org/ontology/order-to-cash#AUTHORIZED_AS
    domain: "Discount Approval"
    range: "Role"
    ends_defined_in_other_files: {Role: manufacturing}
  - label: has credit check
    type: HAS_CREDIT_CHECK
    iri: http://example.org/ontology/order-to-cash#HAS_CREDIT_CHECK
    domain: "Sales Order"
    range: "Credit Check"
    ends_defined_in_other_files: {Sales Order: manufacturing}
  - label: has discount approval
    type: HAS_DISCOUNT_APPROVAL
    iri: http://example.org/ontology/order-to-cash#HAS_DISCOUNT_APPROVAL
    domain: "Sales Order"
    range: "Discount Approval"
    ends_defined_in_other_files: {Sales Order: manufacturing}
  - label: has escalation
    type: HAS_ESCALATION
    iri: http://example.org/ontology/order-to-cash#HAS_ESCALATION
    domain: "Sales Order"
    range: "Escalation Path"
    ends_defined_in_other_files: {Sales Order: manufacturing}
  - label: invoiced as
    type: INVOICED_AS
    iri: http://example.org/ontology/order-to-cash#INVOICED_AS
    domain: "Sales Order"
    range: "Invoice"
    ends_defined_in_other_files: {Sales Order: manufacturing}
  - label: involves
    type: INVOLVES
    iri: http://example.org/ontology/order-to-cash#INVOLVES
    domain: "Escalation Path"
    range: "Role"
    ends_defined_in_other_files: {Role: manufacturing}
  - label: validated
    type: VALIDATED
    iri: http://example.org/ontology/order-to-cash#VALIDATED
    domain: "Person"
    range: "Credit Check"
    ends_defined_in_other_files: {Person: manufacturing}
    sub_property_of: participant in

# Relationships declared in other files that involve this file's classes
related_relationships: []