<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/ontology/order-to-cash#"
     xml:base="http://example.org/ontology/order-to-cash"
     xmlns:o2c="http://example.org/ontology/order-to-cash#"
     xmlns:biz="http://example.org/ontology/business#"
     xmlns:mfg="http://example.org/ontology/manufacturing#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dc="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://example.org/ontology/order-to-cash">
        <owl:imports rdf:resource="http://example.org/ontology/manufacturing"/>
        <owl:versionInfo>0.1.0 draft</owl:versionInfo>
        <dc:title>Order-to-Cash Ontology</dc:title>
        <dc:created>2026-11-04</dc:created>
        <dc:modified>2026-11-04</dc:modified>
        <dc:description xml:lang="en">Order-to-cash classes for a manufacturer: credit check, discount approval, invoicing and escalation. Each class has one manufacturing-layer parent, which in turn has a business-layer parent. Replace the example.org namespace with your own before use.</dc:description>
    </owl:Ontology>

    <!-- ///////////////  Classes  /////////////// -->

    <owl:Class rdf:about="http://example.org/ontology/order-to-cash#CreditCheck">
        <rdfs:label xml:lang="en">Credit Check</rdfs:label>
        <skos:prefLabel xml:lang="en">Credit Check</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/manufacturing#ManufacturingAssessment"/>
        <skos:definition xml:lang="en">A check of a customer's credit on an order, with an outcome of Pass, Hold or Reject.</skos:definition>
        <dc:source>Order-to-Cash</dc:source>
        <skos:editorialNote xml:lang="en">The outcome is a result, so an assessment fits better than an approval.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/order-to-cash#DiscountApproval">
        <rdfs:label xml:lang="en">Discount Approval</rdfs:label>
        <skos:prefLabel xml:lang="en">Discount Approval</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/manufacturing#OrderApproval"/>
        <skos:definition xml:lang="en">An approval of a discount on an order, at a tier that decides which role must authorize it.</skos:definition>
        <dc:source>Order-to-Cash; Revenue Recognition</dc:source>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/order-to-cash#Invoice">
        <rdfs:label xml:lang="en">Invoice</rdfs:label>
        <skos:prefLabel xml:lang="en">Invoice</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/manufacturing#BillingDocument"/>
        <skos:definition xml:lang="en">A bill sent to the customer for an order, with payment terms and currency.</skos:definition>
        <dc:source>Order-to-Cash</dc:source>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/order-to-cash#EscalationPath">
        <rdfs:label xml:lang="en">Escalation Path</rdfs:label>
        <skos:prefLabel xml:lang="en">Escalation Path</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/manufacturing#ManufacturingProcedure"/>
        <skos:definition xml:lang="en">The steps and roles to follow when an exceptional scenario occurs, with a resolution time target.</skos:definition>
        <dc:source>Order-to-Cash</dc:source>
    </owl:Class>

    <!-- ///////////////  Object properties  /////////////// -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/order-to-cash#HAS_CREDIT_CHECK">
        <rdfs:label xml:lang="en">has credit check</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/manufacturing#SalesOrder"/>
        <rdfs:range rdf:resource="http://example.org/ontology/order-to-cash#CreditCheck"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/order-to-cash#HAS_DISCOUNT_APPROVAL">
        <rdfs:label xml:lang="en">has discount approval</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/manufacturing#SalesOrder"/>
        <rdfs:range rdf:resource="http://example.org/ontology/order-to-cash#DiscountApproval"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/order-to-cash#APPROVED_BY">
        <rdfs:label xml:lang="en">approved by</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/order-to-cash#DiscountApproval"/>
        <rdfs:range rdf:resource="http://example.org/ontology/manufacturing#Person"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/order-to-cash#AUTHORIZED_AS">
        <rdfs:label xml:lang="en">authorized as</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/order-to-cash#DiscountApproval"/>
        <rdfs:range rdf:resource="http://example.org/ontology/manufacturing#Role"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/order-to-cash#APPROVED">
        <rdfs:label xml:lang="en">approved</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://example.org/ontology/business#approves"/>
        <rdfs:domain rdf:resource="http://example.org/ontology/manufacturing#Person"/>
        <rdfs:range rdf:resource="http://example.org/ontology/order-to-cash#DiscountApproval"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/order-to-cash#VALIDATED">
        <rdfs:label xml:lang="en">validated</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://example.org/ontology/business#participantIn"/>
        <rdfs:domain rdf:resource="http://example.org/ontology/manufacturing#Person"/>
        <rdfs:range rdf:resource="http://example.org/ontology/order-to-cash#CreditCheck"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/order-to-cash#INVOICED_AS">
        <rdfs:label xml:lang="en">invoiced as</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/manufacturing#SalesOrder"/>
        <rdfs:range rdf:resource="http://example.org/ontology/order-to-cash#Invoice"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/order-to-cash#HAS_ESCALATION">
        <rdfs:label xml:lang="en">has escalation</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/manufacturing#SalesOrder"/>
        <rdfs:range rdf:resource="http://example.org/ontology/order-to-cash#EscalationPath"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/order-to-cash#INVOLVES">
        <rdfs:label xml:lang="en">involves</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/order-to-cash#EscalationPath"/>
        <rdfs:range rdf:resource="http://example.org/ontology/manufacturing#Role"/>
    </owl:ObjectProperty>

</rdf:RDF>
