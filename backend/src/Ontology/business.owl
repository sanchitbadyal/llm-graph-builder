            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessDocument"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Policy"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Procedure"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Regulation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/business#createdOn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">created on</rdfs:label>
        <skos:prefLabel xml:lang="en">created on</skos:prefLabel>
        <skos:definition xml:lang="en">The date and time at which a record was created.</skos:definition>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/business#effectiveFrom">
        <rdfs:label xml:lang="en">effective from</rdfs:label>
        <skos:prefLabel xml:lang="en">effective from</skos:prefLabel>
        <skos:definition xml:lang="en">The date from which something is valid.</skos:definition>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessDocument"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Policy"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessRule"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Procedure"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Regulation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/business#effectiveUntil">
        <rdfs:label xml:lang="en">effective until</rdfs:label>
        <skos:prefLabel xml:lang="en">effective until</skos:prefLabel>
        <skos:definition xml:lang="en">The date after which something is no longer valid.</skos:definition>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessDocument"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Policy"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessRule"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Procedure"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Regulation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/business#documentNumber">
        <rdfs:label xml:lang="en">document number</rdfs:label>
        <skos:prefLabel xml:lang="en">document number</skos:prefLabel>
        <skos:definition xml:lang="en">The number printed on a business document.</skos:definition>
        <rdfs:domain rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/business#documentDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">document date</rdfs:label>
        <skos:prefLabel xml:lang="en">document date</skos:prefLabel>
        <skos:definition xml:lang="en">The date shown on a business document.</skos:definition>
