                    <rdf:Description rdf:about="http://example.org/ontology/business#DocumentStatus_Rejected"/>
                    <rdf:Description rdf:about="http://example.org/ontology/business#DocumentStatus_Issued"/>
                    <rdf:Description rdf:about="http://example.org/ontology/business#DocumentStatus_Shipped"/>
