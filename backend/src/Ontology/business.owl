<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/ontology/business#"
     xml:base="http://example.org/ontology/business"
     xmlns:biz="http://example.org/ontology/business#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dc="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://example.org/ontology/business">
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <owl:versionInfo>0.2.0 draft</owl:versionInfo>
        <dc:title>Business Layer Ontology</dc:title>
        <dc:created>2026-11-04</dc:created>
        <dc:modified>2026-11-04</dc:modified>
        <dc:description xml:lang="en">Reusable business concepts, each anchored to one BFO class. Domain ontologies (for example Order-to-Cash) specialise these classes. Replace the example.org namespace with your own before use. Alignments to W3C ORG, FIBO FND and OMG Commons in editorial notes are unverified and written from general knowledge.</dc:description>
    </owl:Ontology>

    <!-- Annotation properties are the standard SKOS ones. -->

    <!-- ///////////////  Classes (existing, then new)  /////////////// -->


    <owl:Class rdf:about="http://example.org/ontology/business#Organization">
        <rdfs:label xml:lang="en">Organization</rdfs:label>
        <skos:prefLabel xml:lang="en">Organization</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <skos:definition xml:lang="en">A group of people or other organizations that together form a unit acting under a common name, such as a company or an agency.</skos:definition>
        <skos:example xml:lang="en">a customer company; a supplier; Cabalmar Chemicals</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): W3C ORG: Organization. FIBO FND: FormalOrganization. OMG Commons: Organizations. Pick one source and keep the others as notes.</skos:editorialNote>
        <skos:closeMatch rdf:resource="http://www.w3.org/ns/org#Organization"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#OrganizationalUnit">
        <rdfs:label xml:lang="en">Organizational Unit</rdfs:label>
        <skos:prefLabel xml:lang="en">Organizational Unit</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Organization"/>
        <skos:definition xml:lang="en">A part of an organization, such as a department, team or plant management group.</skos:definition>
        <skos:example xml:lang="en">finance department; credit team</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): W3C ORG: OrganizationalUnit.</skos:editorialNote>
        <skos:closeMatch rdf:resource="http://www.w3.org/ns/org#OrganizationalUnit"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Person">
        <rdfs:label xml:lang="en">Person</rdfs:label>
        <skos:prefLabel xml:lang="en">Person</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <skos:definition xml:lang="en">A human being.</skos:definition>
        <skos:example xml:lang="en">a credit manager; a sales representative</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): FIBO FND: Person. OMG Commons: Parties and Situations.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#BusinessRole">
        <rdfs:label xml:lang="en">Business Role</rdfs:label>
        <skos:prefLabel xml:lang="en">Business Role</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <skos:definition xml:lang="en">A role that a person or organization has because of its situation in a business setting, which it does not have to have.</skos:definition>
        <skos:example xml:lang="en">approver; customer; credit manager</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): W3C ORG: Role (note: ORG models Role as a concept, not as a BFO role). OMG Commons: Roles and Compositions.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#CounterpartyRole">
        <rdfs:label xml:lang="en">Counterparty Role</rdfs:label>
        <skos:prefLabel xml:lang="en">Counterparty Role</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessRole"/>
        <skos:definition xml:lang="en">A business role held by a party that takes part in a business transaction with the company.</skos:definition>
        <skos:example xml:lang="en">customer; supplier; carrier</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#ApproverRole">
        <rdfs:label xml:lang="en">Approver Role</rdfs:label>
        <skos:prefLabel xml:lang="en">Approver Role</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessRole"/>
        <skos:definition xml:lang="en">A business role that grants the holder authority to accept or reject a request.</skos:definition>
        <skos:example xml:lang="en">credit manager; finance controller</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Position">
        <rdfs:label xml:lang="en">Position</rdfs:label>
        <skos:prefLabel xml:lang="en">Position</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <skos:definition xml:lang="en">A post in an organization that can be held by a person.</skos:definition>
        <skos:example xml:lang="en">head of credit control</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): W3C ORG: Post.</skos:editorialNote>
        <skos:closeMatch rdf:resource="http://www.w3.org/ns/org#Post"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Facility">
        <rdfs:label xml:lang="en">Facility</rdfs:label>
        <skos:prefLabel xml:lang="en">Facility</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <skos:definition xml:lang="en">A material entity, such as a building or an installation, where business activity takes place.</skos:definition>
        <skos:example xml:lang="en">chemical plant; warehouse; loading dock</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): OMG Commons: Sites and Facilities.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Location">
        <rdfs:label xml:lang="en">Location</rdfs:label>
        <skos:prefLabel xml:lang="en">Location</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <skos:definition xml:lang="en">A bounded place in space that something can be located at.</skos:definition>
        <skos:example xml:lang="en">the plant site; a delivery destination</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): OMG Commons: Locations. W3C ORG: Site.</skos:editorialNote>
        <skos:closeMatch rdf:resource="http://www.w3.org/ns/org#Site"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Product">
        <rdfs:label xml:lang="en">Product</rdfs:label>
        <skos:prefLabel xml:lang="en">Product</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <skos:definition xml:lang="en">A material good that the company makes, buys or sells. A catalogue entry that describes a type of product is a business document, not a product. A service is not a product either; see Service.</skos:definition>
        <skos:example xml:lang="en">a batch of solvent; packaged chemical</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): FIBO FND: ProductsAndServices.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#BusinessDocument">
        <rdfs:label xml:lang="en">Business Document</rdfs:label>
        <skos:prefLabel xml:lang="en">Business Document</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <skos:definition xml:lang="en">Information content recorded in a document that supports a business transaction or process. The act of creating the document is a business process.</skos:definition>
        <skos:example xml:lang="en">order; invoice; delivery note</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): FIBO FND: Documents. OMG Commons: Documents.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Contract">
        <rdfs:label xml:lang="en">Contract</rdfs:label>
        <skos:prefLabel xml:lang="en">Contract</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <skos:definition xml:lang="en">A business document that records an agreement between parties.</skos:definition>
        <skos:example xml:lang="en">a sales contract; framework agreement</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): FIBO FND: Contracts, Agreements.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Policy">
        <rdfs:label xml:lang="en">Policy</rdfs:label>
        <skos:prefLabel xml:lang="en">Policy</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <skos:definition xml:lang="en">A statement of intent or principle that guides business decisions.</skos:definition>
        <skos:example xml:lang="en">credit policy; discount policy</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#BusinessRule">
        <rdfs:label xml:lang="en">Business Rule</rdfs:label>
        <skos:prefLabel xml:lang="en">Business Rule</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <skos:definition xml:lang="en">A statement that sets a condition or limit for how a business process is carried out.</skos:definition>
        <skos:example xml:lang="en">discounts above a threshold need approval</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Address">
        <rdfs:label xml:lang="en">Address</rdfs:label>
        <skos:prefLabel xml:lang="en">Address</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <skos:definition xml:lang="en">Information that identifies a place for delivery or contact.</skos:definition>
        <skos:example xml:lang="en">a ship-to address; a bill-to address</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): FIBO FND: Addresses.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#BusinessProcess">
        <rdfs:label xml:lang="en">Business Process</rdfs:label>
        <skos:prefLabel xml:lang="en">Business Process</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <skos:definition xml:lang="en">A process that is carried out by or for an organization to reach a business goal.</skos:definition>
        <skos:example xml:lang="en">order handling; month-end close</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Approval">
        <rdfs:label xml:lang="en">Approval</rdfs:label>
        <skos:prefLabel xml:lang="en">Approval</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
        <skos:definition xml:lang="en">A business process in which a party with authority accepts or rejects a request.</skos:definition>
        <skos:example xml:lang="en">credit approval; discount approval</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Payment">
        <rdfs:label xml:lang="en">Payment</rdfs:label>
        <skos:prefLabel xml:lang="en">Payment</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
        <skos:definition xml:lang="en">A business process in which money is transferred from one party to another.</skos:definition>
        <skos:example xml:lang="en">payment collection; refund</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Fulfillment">
        <rdfs:label xml:lang="en">Fulfillment</rdfs:label>
        <skos:prefLabel xml:lang="en">Fulfillment</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
        <skos:definition xml:lang="en">A business process in which goods or services are prepared and delivered to meet an order.</skos:definition>
        <skos:example xml:lang="en">picking, packing and dispatch</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Billing">
        <rdfs:label xml:lang="en">Billing</rdfs:label>
        <skos:prefLabel xml:lang="en">Billing</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
        <skos:definition xml:lang="en">A business process in which a party is asked to pay for goods or services delivered.</skos:definition>
        <skos:example xml:lang="en">invoicing; dunning</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#BusinessAttribute">
        <rdfs:label xml:lang="en">Business Attribute</rdfs:label>
        <skos:prefLabel xml:lang="en">Business Attribute</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <skos:definition xml:lang="en">A characteristic of a business entity that can be described or measured.</skos:definition>
        <skos:example xml:lang="en">credit limit; payment terms</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Quantity">
        <rdfs:label xml:lang="en">Quantity</rdfs:label>
        <skos:prefLabel xml:lang="en">Quantity</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessAttribute"/>
        <skos:definition xml:lang="en">A measurable amount of something, expressed with a unit of measure.</skos:definition>
        <skos:example xml:lang="en">500 kg; 2 tonnes</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): OMG Commons: Quantities and Units.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#MonetaryAmount">
        <rdfs:label xml:lang="en">Monetary Amount</rdfs:label>
        <skos:prefLabel xml:lang="en">Monetary Amount</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessAttribute"/>
        <skos:definition xml:lang="en">An amount of money, expressed in a currency.</skos:definition>
        <skos:example xml:lang="en">an invoice total of 1,200 USD</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): FIBO FND: CurrencyAmount.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Status">
        <rdfs:label xml:lang="en">Status</rdfs:label>
        <skos:prefLabel xml:lang="en">Status</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessAttribute"/>
        <skos:definition xml:lang="en">The stage that a business entity has reached in its lifecycle. The allowed values are the named individuals of its subclasses, such as DocumentStatus.</skos:definition>
        <skos:example xml:lang="en">approved; shipped; paid</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): FIBO FND: Lifecycles.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#UnitOfMeasure">
        <rdfs:label xml:lang="en">Unit of Measure</rdfs:label>
        <skos:prefLabel xml:lang="en">Unit of Measure</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <skos:definition xml:lang="en">A standard that a quantity is measured against.</skos:definition>
        <skos:example xml:lang="en">kilogram; litre; tonne</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): OMG Commons: Quantities and Units.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Currency">
        <rdfs:label xml:lang="en">Currency</rdfs:label>
        <skos:prefLabel xml:lang="en">Currency</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#UnitOfMeasure"/>
        <skos:definition xml:lang="en">A unit of measure for monetary amounts.</skos:definition>
        <skos:example xml:lang="en">USD; EUR; INR</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): FIBO FND: ISO4217 currency codes.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Assessment">
        <rdfs:label xml:lang="en">Assessment</rdfs:label>
        <skos:prefLabel xml:lang="en">Assessment</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
        <skos:definition xml:lang="en">A business process in which something is examined or tested and a result or outcome is recorded.</skos:definition>
        <skos:example xml:lang="en">credit check; quality check</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Transport">
        <rdfs:label xml:lang="en">Transport</rdfs:label>
        <skos:prefLabel xml:lang="en">Transport</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
        <skos:definition xml:lang="en">A business process in which goods are moved from one place to another.</skos:definition>
        <skos:example xml:lang="en">a shipment by road or sea</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#AccountingEntry">
        <rdfs:label xml:lang="en">Accounting Entry</rdfs:label>
        <skos:prefLabel xml:lang="en">Accounting Entry</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <skos:definition xml:lang="en">A business document that records a financial posting.</skos:definition>
        <skos:example xml:lang="en">revenue entry; accrual; deferral</skos:example>
        <skos:editorialNote xml:lang="en">Source alignment (from memory, not verified against the source files): FIBO FND: Accounting.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Procedure">
        <rdfs:label xml:lang="en">Procedure</rdfs:label>
        <skos:prefLabel xml:lang="en">Procedure</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <skos:definition xml:lang="en">A documented sequence of steps or checks to follow in a given situation.</skos:definition>
        <skos:example xml:lang="en">an escalation path; an internal control</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Regulation">
        <rdfs:label xml:lang="en">Regulation</rdfs:label>
        <skos:prefLabel xml:lang="en">Regulation</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <skos:definition xml:lang="en">A rule set by a legal or standards authority that a business must follow.</skos:definition>
        <skos:example xml:lang="en">a chemical safety regulation; an accounting standard</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Metric">
        <rdfs:label xml:lang="en">Metric</rdfs:label>
        <skos:prefLabel xml:lang="en">Metric</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <skos:definition xml:lang="en">A defined measure of performance, with a definition and often a target.</skos:definition>
        <skos:example xml:lang="en">on-time delivery rate</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#InformationSystem">
        <rdfs:label xml:lang="en">Information System</rdfs:label>
        <skos:prefLabel xml:lang="en">Information System</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <skos:definition xml:lang="en">A software system that a business uses to record or run its work. Modeled as software content; change the parent to object if you want to model the installed hardware too.</skos:definition>
        <skos:example xml:lang="en">an ERP system; a customer portal</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#TimePeriod">
        <rdfs:label xml:lang="en">Time Period</rdfs:label>
        <skos:prefLabel xml:lang="en">Time Period</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <skos:definition xml:lang="en">A stretch of time that business activity is grouped by. Parent is the broad BFO occurrent because this BFO file has no temporal region class.</skos:definition>
        <skos:example xml:lang="en">a fiscal quarter; a month</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#CustomerRole">
        <rdfs:label xml:lang="en">Customer Role</rdfs:label>
        <skos:prefLabel xml:lang="en">Customer Role</skos:prefLabel>
        <skos:altLabel xml:lang="en">Buyer Role</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#CounterpartyRole"/>
        <skos:definition xml:lang="en">A counterparty role held by a party that buys goods or services from the company.</skos:definition>
        <skos:example xml:lang="en">a customer company</skos:example>
        <skos:editorialNote xml:lang="en">Alignment (unverified, from general knowledge, not checked against the source files): W3C ORG: Role. FIBO FND: Counterparty.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#SupplierRole">
        <rdfs:label xml:lang="en">Supplier Role</rdfs:label>
        <skos:prefLabel xml:lang="en">Supplier Role</skos:prefLabel>
        <skos:altLabel xml:lang="en">Vendor Role</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#CounterpartyRole"/>
        <skos:definition xml:lang="en">A counterparty role held by a party that sells goods or services to the company.</skos:definition>
        <skos:example xml:lang="en">a raw material vendor</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#CarrierRole">
        <rdfs:label xml:lang="en">Carrier Role</rdfs:label>
        <skos:prefLabel xml:lang="en">Carrier Role</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#CounterpartyRole"/>
        <skos:definition xml:lang="en">A counterparty role held by a party that moves goods for the company.</skos:definition>
        <skos:example xml:lang="en">a road haulage firm; a shipping line</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#EmployeeRole">
        <rdfs:label xml:lang="en">Employee Role</rdfs:label>
        <skos:prefLabel xml:lang="en">Employee Role</skos:prefLabel>
        <skos:altLabel xml:lang="en">Staff Role</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessRole"/>
        <skos:definition xml:lang="en">A business role held by a person who works for the company.</skos:definition>
        <skos:example xml:lang="en">a sales representative</skos:example>
        <skos:editorialNote xml:lang="en">Alignment (unverified, from general knowledge, not checked against the source files): W3C ORG: Membership.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#LegalEntity">
        <rdfs:label xml:lang="en">Legal Entity</rdfs:label>
        <skos:prefLabel xml:lang="en">Legal Entity</skos:prefLabel>
        <skos:altLabel xml:lang="en">Legal Person</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Organization"/>
        <skos:definition xml:lang="en">An organization that is recognised in law as able to own assets and sign contracts.</skos:definition>
        <skos:example xml:lang="en">Cabalmar Chemicals Ltd</skos:example>
        <skos:editorialNote xml:lang="en">Alignment (unverified, from general knowledge, not checked against the source files): FIBO FND: LegalEntity.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Warehouse">
        <rdfs:label xml:lang="en">Warehouse</rdfs:label>
        <skos:prefLabel xml:lang="en">Warehouse</skos:prefLabel>
        <skos:altLabel xml:lang="en">Storage Facility</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Facility"/>
        <skos:definition xml:lang="en">A facility used mainly to store goods.</skos:definition>
        <skos:example xml:lang="en">a finished goods store</skos:example>
        <skos:editorialNote xml:lang="en">Alignment (unverified, from general knowledge, not checked against the source files): OMG Commons: Sites and Facilities.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Account">
        <rdfs:label xml:lang="en">Account</rdfs:label>
        <skos:prefLabel xml:lang="en">Account</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <skos:definition xml:lang="en">A record that tracks the dealings between the company and one party over time, such as balances and terms.</skos:definition>
        <skos:example xml:lang="en">a customer account</skos:example>
        <skos:editorialNote xml:lang="en">Alignment (unverified, from general knowledge, not checked against the source files): FIBO FND: Accounting.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Service">
        <rdfs:label xml:lang="en">Service</rdfs:label>
        <skos:prefLabel xml:lang="en">Service</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
        <skos:definition xml:lang="en">A business process in which work is done for a party instead of a material good being handed over. Modeled as a process because a service is performed and not held.</skos:definition>
        <skos:example xml:lang="en">a laboratory test; a tank cleaning</skos:example>
        <skos:editorialNote xml:lang="en">Alignment (unverified, from general knowledge, not checked against the source files): FIBO FND: ProductsAndServices.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#RawMaterial">
        <rdfs:label xml:lang="en">Raw Material</rdfs:label>
        <skos:prefLabel xml:lang="en">Raw Material</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Product"/>
        <skos:definition xml:lang="en">A material good that the company buys or holds in order to make other products.</skos:definition>
        <skos:example xml:lang="en">a solvent input</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Batch">
        <rdfs:label xml:lang="en">Batch</rdfs:label>
        <skos:prefLabel xml:lang="en">Batch</skos:prefLabel>
        <skos:altLabel xml:lang="en">Lot</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Product"/>
        <skos:definition xml:lang="en">A quantity of product made or handled together under the same conditions and tracked as one unit.</skos:definition>
        <skos:example xml:lang="en">one production run of solvent</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#PackagedUnit">
        <rdfs:label xml:lang="en">Packaged Unit</rdfs:label>
        <skos:prefLabel xml:lang="en">Packaged Unit</skos:prefLabel>
        <skos:altLabel xml:lang="en">Container Unit</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Product"/>
        <skos:definition xml:lang="en">A product in a package or container that is ready for storage or shipment.</skos:definition>
        <skos:example xml:lang="en">a 200-litre drum</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#ProductCategory">
        <rdfs:label xml:lang="en">Product Category</rdfs:label>
        <skos:prefLabel xml:lang="en">Product Category</skos:prefLabel>
        <skos:altLabel xml:lang="en">Product Group</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <skos:definition xml:lang="en">A named group that products or services are classified into.</skos:definition>
        <skos:example xml:lang="en">solvents; resins</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Order">
        <rdfs:label xml:lang="en">Order</rdfs:label>
        <skos:prefLabel xml:lang="en">Order</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <skos:definition xml:lang="en">A business document in which a party asks for goods or services on stated terms.</skos:definition>
        <skos:example xml:lang="en">a customer order</skos:example>
        <skos:editorialNote xml:lang="en">Alignment (unverified, from general knowledge, not checked against the source files): FIBO FND: Documents.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#SalesOrder">
        <rdfs:label xml:lang="en">Sales Order</rdfs:label>
        <skos:prefLabel xml:lang="en">Sales Order</skos:prefLabel>
        <skos:altLabel xml:lang="en">Customer Order</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Order"/>
        <skos:definition xml:lang="en">An order in which a customer asks the company to supply goods or services.</skos:definition>
        <skos:example xml:lang="en">a customer purchase order received</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#PurchaseOrder">
        <rdfs:label xml:lang="en">Purchase Order</rdfs:label>
        <skos:prefLabel xml:lang="en">Purchase Order</skos:prefLabel>
        <skos:altLabel xml:lang="en">Supplier Order</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Order"/>
        <skos:definition xml:lang="en">An order in which the company asks a supplier to supply goods or services.</skos:definition>
        <skos:example xml:lang="en">an order for raw material</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Quote">
        <rdfs:label xml:lang="en">Quote</rdfs:label>
        <skos:prefLabel xml:lang="en">Quote</skos:prefLabel>
        <skos:altLabel xml:lang="en">Quotation</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <skos:definition xml:lang="en">A business document that offers goods or services at a stated price and terms.</skos:definition>
        <skos:example xml:lang="en">a price quotation</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Invoice">
        <rdfs:label xml:lang="en">Invoice</rdfs:label>
        <skos:prefLabel xml:lang="en">Invoice</skos:prefLabel>
        <skos:altLabel xml:lang="en">Bill</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <skos:definition xml:lang="en">A business document that asks a party to pay for goods or services delivered.</skos:definition>
        <skos:example xml:lang="en">a customer invoice</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#CreditNote">
        <rdfs:label xml:lang="en">Credit Note</rdfs:label>
        <skos:prefLabel xml:lang="en">Credit Note</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <skos:definition xml:lang="en">A business document that reduces or cancels an amount that was invoiced.</skos:definition>
        <skos:example xml:lang="en">a credit for returned goods</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Receipt">
        <rdfs:label xml:lang="en">Receipt</rdfs:label>
        <skos:prefLabel xml:lang="en">Receipt</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <skos:definition xml:lang="en">A business document that confirms that a payment or goods were received.</skos:definition>
        <skos:example xml:lang="en">a payment receipt; a goods receipt</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#DeliveryNote">
        <rdfs:label xml:lang="en">Delivery Note</rdfs:label>
        <skos:prefLabel xml:lang="en">Delivery Note</skos:prefLabel>
        <skos:altLabel xml:lang="en">Dispatch Note</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <skos:definition xml:lang="en">A business document that lists the goods sent in one delivery.</skos:definition>
        <skos:example xml:lang="en">a dispatch note</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#ProofOfDelivery">
        <rdfs:label xml:lang="en">Proof Of Delivery</rdfs:label>
        <skos:prefLabel xml:lang="en">Proof Of Delivery</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <skos:definition xml:lang="en">A business document that confirms goods reached the receiving party.</skos:definition>
        <skos:example xml:lang="en">a signed delivery receipt</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Certificate">
        <rdfs:label xml:lang="en">Certificate</rdfs:label>
        <skos:prefLabel xml:lang="en">Certificate</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <skos:definition xml:lang="en">A business document in which an authority or the company states that something meets stated requirements.</skos:definition>
        <skos:example xml:lang="en">a certificate of analysis</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Specification">
        <rdfs:label xml:lang="en">Specification</rdfs:label>
        <skos:prefLabel xml:lang="en">Specification</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <skos:definition xml:lang="en">A business document that states the required properties of a product or service.</skos:definition>
        <skos:example xml:lang="en">a product specification sheet</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#BillOfMaterials">
        <rdfs:label xml:lang="en">Bill Of Materials</rdfs:label>
        <skos:prefLabel xml:lang="en">Bill Of Materials</skos:prefLabel>
        <skos:altLabel xml:lang="en">BOM</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <skos:definition xml:lang="en">A business document that lists the materials and quantities needed to make one product.</skos:definition>
        <skos:example xml:lang="en">a formula for a solvent blend</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#ExceptionRecord">
        <rdfs:label xml:lang="en">Exception Record</rdfs:label>
        <skos:prefLabel xml:lang="en">Exception Record</skos:prefLabel>
        <skos:altLabel xml:lang="en">Deviation Record</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <skos:definition xml:lang="en">A business document that records a departure from the expected process or from a requirement.</skos:definition>
        <skos:example xml:lang="en">a non-conformance report; a deviation report</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#DocumentLine">
        <rdfs:label xml:lang="en">Document Line</rdfs:label>
        <skos:prefLabel xml:lang="en">Document Line</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <skos:definition xml:lang="en">A single item entry inside a business document, with its own product, quantity and amount.</skos:definition>
        <skos:example xml:lang="en">one line of an order</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#OrderLine">
        <rdfs:label xml:lang="en">Order Line</rdfs:label>
        <skos:prefLabel xml:lang="en">Order Line</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#DocumentLine"/>
        <skos:definition xml:lang="en">A line of an order for one product or service.</skos:definition>
        <skos:example xml:lang="en">500 kg of solvent on a customer order</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#InvoiceLine">
        <rdfs:label xml:lang="en">Invoice Line</rdfs:label>
        <skos:prefLabel xml:lang="en">Invoice Line</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#DocumentLine"/>
        <skos:definition xml:lang="en">A line of an invoice for one product or service.</skos:definition>
        <skos:example xml:lang="en">one charge on an invoice</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Manufacturing">
        <rdfs:label xml:lang="en">Manufacturing</rdfs:label>
        <skos:prefLabel xml:lang="en">Manufacturing</skos:prefLabel>
        <skos:altLabel xml:lang="en">Production</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
        <skos:definition xml:lang="en">A business process in which materials are turned into products.</skos:definition>
        <skos:example xml:lang="en">a production run</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Procurement">
        <rdfs:label xml:lang="en">Procurement</rdfs:label>
        <skos:prefLabel xml:lang="en">Procurement</skos:prefLabel>
        <skos:altLabel xml:lang="en">Purchasing</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
        <skos:definition xml:lang="en">A business process in which the company obtains goods or services from suppliers.</skos:definition>
        <skos:example xml:lang="en">buying raw material</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Delivery">
        <rdfs:label xml:lang="en">Delivery</rdfs:label>
        <skos:prefLabel xml:lang="en">Delivery</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Fulfillment"/>
        <skos:definition xml:lang="en">A fulfillment process in which goods are handed over at the destination.</skos:definition>
        <skos:example xml:lang="en">handover at a customer site</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Collection">
        <rdfs:label xml:lang="en">Collection</rdfs:label>
        <skos:prefLabel xml:lang="en">Collection</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Payment"/>
        <skos:definition xml:lang="en">A payment process in which money owed to the company is received.</skos:definition>
        <skos:example xml:lang="en">receiving a customer payment</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Reconciliation">
        <rdfs:label xml:lang="en">Reconciliation</rdfs:label>
        <skos:prefLabel xml:lang="en">Reconciliation</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
        <skos:definition xml:lang="en">A business process in which two sets of records are compared and differences are resolved.</skos:definition>
        <skos:example xml:lang="en">matching payments to invoices</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#RevenueRecognition">
        <rdfs:label xml:lang="en">Revenue Recognition</rdfs:label>
        <skos:prefLabel xml:lang="en">Revenue Recognition</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
        <skos:definition xml:lang="en">A business process in which earned revenue is recorded in the accounts for a period.</skos:definition>
        <skos:example xml:lang="en">booking revenue when goods are delivered</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Return">
        <rdfs:label xml:lang="en">Return</rdfs:label>
        <skos:prefLabel xml:lang="en">Return</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
        <skos:definition xml:lang="en">A business process in which goods are sent back by the receiving party.</skos:definition>
        <skos:example xml:lang="en">a customer return</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Inspection">
        <rdfs:label xml:lang="en">Inspection</rdfs:label>
        <skos:prefLabel xml:lang="en">Inspection</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Assessment"/>
        <skos:definition xml:lang="en">An assessment in which goods or work are examined against stated requirements.</skos:definition>
        <skos:example xml:lang="en">a batch quality check</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Audit">
        <rdfs:label xml:lang="en">Audit</rdfs:label>
        <skos:prefLabel xml:lang="en">Audit</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Assessment"/>
        <skos:definition xml:lang="en">An assessment in which records or controls are examined by an independent party.</skos:definition>
        <skos:example xml:lang="en">an internal control audit</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Escalation">
        <rdfs:label xml:lang="en">Escalation</rdfs:label>
        <skos:prefLabel xml:lang="en">Escalation</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
        <skos:definition xml:lang="en">A business process in which a matter is passed to a higher level of authority.</skos:definition>
        <skos:example xml:lang="en">sending an unpaid invoice to the finance controller</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#StockTransfer">
        <rdfs:label xml:lang="en">Stock Transfer</rdfs:label>
        <skos:prefLabel xml:lang="en">Stock Transfer</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Transport"/>
        <skos:definition xml:lang="en">A transport process in which goods are moved from one facility of the company to another.</skos:definition>
        <skos:example xml:lang="en">an inter-plant transfer</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Milestone">
        <rdfs:label xml:lang="en">Milestone</rdfs:label>
        <skos:prefLabel xml:lang="en">Milestone</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000035"/>
        <skos:definition xml:lang="en">A point in time at which a business process reaches a defined stage.</skos:definition>
        <skos:example xml:lang="en">order released; goods dispatched</skos:example>
        <skos:editorialNote xml:lang="en">Parent is the BFO process boundary.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Price">
        <rdfs:label xml:lang="en">Price</rdfs:label>
        <skos:prefLabel xml:lang="en">Price</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#MonetaryAmount"/>
        <skos:definition xml:lang="en">A monetary amount asked for one unit of a product or service.</skos:definition>
        <skos:example xml:lang="en">12.50 USD per kg</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Cost">
        <rdfs:label xml:lang="en">Cost</rdfs:label>
        <skos:prefLabel xml:lang="en">Cost</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#MonetaryAmount"/>
        <skos:definition xml:lang="en">A monetary amount that the company spends to obtain or make something.</skos:definition>
        <skos:example xml:lang="en">the production cost of a batch</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Tax">
        <rdfs:label xml:lang="en">Tax</rdfs:label>
        <skos:prefLabel xml:lang="en">Tax</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#MonetaryAmount"/>
        <skos:definition xml:lang="en">A monetary amount that is owed to a tax authority.</skos:definition>
        <skos:example xml:lang="en">sales tax on an invoice</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#CreditLimit">
        <rdfs:label xml:lang="en">Credit Limit</rdfs:label>
        <skos:prefLabel xml:lang="en">Credit Limit</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#MonetaryAmount"/>
        <skos:definition xml:lang="en">The highest amount of unpaid credit that the company allows a party to have.</skos:definition>
        <skos:example xml:lang="en">a customer credit limit</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Discount">
        <rdfs:label xml:lang="en">Discount</rdfs:label>
        <skos:prefLabel xml:lang="en">Discount</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessAttribute"/>
        <skos:definition xml:lang="en">A reduction from a price, stated as an amount or as a percentage.</skos:definition>
        <skos:example xml:lang="en">a volume discount</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#PaymentTerms">
        <rdfs:label xml:lang="en">Payment Terms</rdfs:label>
        <skos:prefLabel xml:lang="en">Payment Terms</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessAttribute"/>
        <skos:definition xml:lang="en">The conditions that say when and how a payment must be made.</skos:definition>
        <skos:example xml:lang="en">net 30 days</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Percentage">
        <rdfs:label xml:lang="en">Percentage</rdfs:label>
        <skos:prefLabel xml:lang="en">Percentage</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Quantity"/>
        <skos:definition xml:lang="en">A quantity expressed as a part of one hundred.</skos:definition>
        <skos:example xml:lang="en">5 percent</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Duration">
        <rdfs:label xml:lang="en">Duration</rdfs:label>
        <skos:prefLabel xml:lang="en">Duration</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Quantity"/>
        <skos:definition xml:lang="en">A quantity that measures a length of time.</skos:definition>
        <skos:example xml:lang="en">30 days</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#LedgerAccount">
        <rdfs:label xml:lang="en">Ledger Account</rdfs:label>
        <skos:prefLabel xml:lang="en">Ledger Account</skos:prefLabel>
        <skos:altLabel xml:lang="en">GL Account</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <skos:definition xml:lang="en">A named account in the books where financial postings are collected.</skos:definition>
        <skos:example xml:lang="en">a revenue account</skos:example>
        <skos:editorialNote xml:lang="en">Alignment (unverified, from general knowledge, not checked against the source files): FIBO FND: Accounting.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#CostCenter">
        <rdfs:label xml:lang="en">Cost Center</rdfs:label>
        <skos:prefLabel xml:lang="en">Cost Center</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#OrganizationalUnit"/>
        <skos:definition xml:lang="en">An organizational unit to which costs are collected.</skos:definition>
        <skos:example xml:lang="en">the plant maintenance cost center</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Threshold">
        <rdfs:label xml:lang="en">Threshold</rdfs:label>
        <skos:prefLabel xml:lang="en">Threshold</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessAttribute"/>
        <skos:definition xml:lang="en">A stated value at which a rule starts or stops applying.</skos:definition>
        <skos:example xml:lang="en">a discount level above which approval is needed</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#ApprovalLevel">
        <rdfs:label xml:lang="en">Approval Level</rdfs:label>
        <skos:prefLabel xml:lang="en">Approval Level</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessAttribute"/>
        <skos:definition xml:lang="en">A tier of authority that says how large a request a role can approve.</skos:definition>
        <skos:example xml:lang="en">level 2 approval</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Control">
        <rdfs:label xml:lang="en">Control</rdfs:label>
        <skos:prefLabel xml:lang="en">Control</skos:prefLabel>
        <skos:altLabel xml:lang="en">Internal Control</skos:altLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Procedure"/>
        <skos:definition xml:lang="en">A procedure that is built in to prevent or detect an error, loss or breach.</skos:definition>
        <skos:example xml:lang="en">dual sign-off on high-value orders</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Risk">
        <rdfs:label xml:lang="en">Risk</rdfs:label>
        <skos:prefLabel xml:lang="en">Risk</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <skos:definition xml:lang="en">A tendency for loss or harm to happen, which may or may not be realised.</skos:definition>
        <skos:example xml:lang="en">customer credit default risk</skos:example>
        <skos:editorialNote xml:lang="en">Parent is the BFO disposition.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Target">
        <rdfs:label xml:lang="en">Target</rdfs:label>
        <skos:prefLabel xml:lang="en">Target</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessAttribute"/>
        <skos:definition xml:lang="en">A value that a metric is expected to reach.</skos:definition>
        <skos:example xml:lang="en">98 percent on-time delivery</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#DocumentStatus">
        <rdfs:label xml:lang="en">Document Status</rdfs:label>
        <skos:prefLabel xml:lang="en">Document Status</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#Status"/>
        <skos:definition xml:lang="en">A status that a business document or process can have. Its allowed values are the named individuals listed under it.</skos:definition>
        <skos:example xml:lang="en">draft; issued; paid</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#ApprovalOutcome">
        <rdfs:label xml:lang="en">Approval Outcome</rdfs:label>
        <skos:prefLabel xml:lang="en">Approval Outcome</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessAttribute"/>
        <skos:definition xml:lang="en">The result of an approval or assessment. Its allowed values are the named individuals listed under it.</skos:definition>
        <skos:example xml:lang="en">approved; rejected</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#FreightMode">
        <rdfs:label xml:lang="en">Freight Mode</rdfs:label>
        <skos:prefLabel xml:lang="en">Freight Mode</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessAttribute"/>
        <skos:definition xml:lang="en">The way goods are carried. Its allowed values are the named individuals listed under it.</skos:definition>
        <skos:example xml:lang="en">road; sea</skos:example>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#Incoterm">
        <rdfs:label xml:lang="en">Incoterm</rdfs:label>
        <skos:prefLabel xml:lang="en">Incoterm</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessAttribute"/>
        <skos:definition xml:lang="en">A standard trade term that says who pays for and carries the risk of transport. Its allowed values are the named individuals listed under it.</skos:definition>
        <skos:example xml:lang="en">FOB; DAP</skos:example>
        <skos:editorialNote xml:lang="en">ICC Incoterms 2020.</skos:editorialNote>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/business#PriorityLevel">
        <rdfs:label xml:lang="en">Priority Level</rdfs:label>
        <skos:prefLabel xml:lang="en">Priority Level</skos:prefLabel>
        <rdfs:subClassOf rdf:resource="http://example.org/ontology/business#BusinessAttribute"/>
        <skos:definition xml:lang="en">How urgently an order or task is to be handled. Its allowed values are the named individuals listed under it.</skos:definition>
        <skos:example xml:lang="en">standard; expedited</skos:example>
    </owl:Class>

    <!-- ///////////////  Object properties (each with an inverse)  /////////////// -->


    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#hasRole">
        <rdfs:label xml:lang="en">has role</rdfs:label>
        <skos:prefLabel xml:lang="en">has role</skos:prefLabel>
        <skos:definition xml:lang="en">Links a person or organization to a business role it holds.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#roleOf"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000196"/>
