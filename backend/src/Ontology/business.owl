            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#Person"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/ontology/business#BusinessRole"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#roleOf">
        <rdfs:label xml:lang="en">role of</rdfs:label>
        <skos:prefLabel xml:lang="en">role of</skos:prefLabel>
        <skos:definition xml:lang="en">Links a business role to the person or organization that holds it.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#hasRole"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000197"/>
