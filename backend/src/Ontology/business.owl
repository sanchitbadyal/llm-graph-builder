    <!-- ///////////////  Datatype properties  /////////////// -->


    <owl:DatatypeProperty rdf:about="http://example.org/ontology/business#name">
        <rdfs:label xml:lang="en">name</rdfs:label>
        <skos:prefLabel xml:lang="en">name</skos:prefLabel>
        <skos:definition xml:lang="en">The name that a business entity is called by.</skos:definition>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/business#description">
        <rdfs:label xml:lang="en">description</rdfs:label>
        <skos:prefLabel xml:lang="en">description</skos:prefLabel>
        <skos:definition xml:lang="en">A free-text description of a business entity.</skos:definition>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/business#identifier">
        <rdfs:label xml:lang="en">identifier</rdfs:label>
        <skos:prefLabel xml:lang="en">identifier</skos:prefLabel>
        <skos:definition xml:lang="en">A code or number that identifies a business entity within its source system or document set.</skos:definition>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/business#versionNumber">
        <rdfs:label xml:lang="en">version number</rdfs:label>
        <skos:prefLabel xml:lang="en">version number</skos:prefLabel>
        <skos:definition xml:lang="en">The version label of a document, policy or procedure.</skos:definition>
