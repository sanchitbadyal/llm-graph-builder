    <owl:Class rdf:about="http://example.org/ontology/business#DocumentStatus">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/ontology/business#DocumentStatus_Draft"/>
                    <rdf:Description rdf:about="http://example.org/ontology/business#DocumentStatus_Submitted"/>
