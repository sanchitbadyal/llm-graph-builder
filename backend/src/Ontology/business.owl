        <skos:prefLabel xml:lang="en">is active</skos:prefLabel>
        <skos:definition xml:lang="en">True if the entity is currently in use.</skos:definition>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#Organization"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Person"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Product"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Facility"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>

