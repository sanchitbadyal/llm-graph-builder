                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#hasParticipant">
        <rdfs:label xml:lang="en">has participant</rdfs:label>
        <skos:prefLabel xml:lang="en">has participant</skos:prefLabel>
