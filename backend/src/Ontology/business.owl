    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#Person"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Organization"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Product"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Facility"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessProcess"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessDocument"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessRole"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessAttribute"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Location"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#TimePeriod"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#Approval"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Payment"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Billing"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Assessment"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
