                <rdf:Description rdf:about="http://example.org/ontology/business#Organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#approves">
        <rdfs:label xml:lang="en">approves</rdfs:label>
        <skos:prefLabel xml:lang="en">approves</skos:prefLabel>
        <skos:definition xml:lang="en">Links a person or role to a process or document that it accepts or authorizes.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#approvedBy"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#Person"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessRole"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessProcess"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessDocument"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#approvedBy">
        <rdfs:label xml:lang="en">approved by</rdfs:label>
        <skos:prefLabel xml:lang="en">approved by</skos:prefLabel>
        <skos:definition xml:lang="en">Links a process or document to the person or role that accepted it.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#approves"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessProcess"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessDocument"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#Person"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessRole"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#produces">
        <rdfs:label xml:lang="en">produces</rdfs:label>
        <skos:prefLabel xml:lang="en">produces</skos:prefLabel>
        <skos:definition xml:lang="en">Links a process to a document or product that it creates.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#producedBy"/>
        <rdfs:domain rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessDocument"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#producedBy">
        <rdfs:label xml:lang="en">produced by</rdfs:label>
        <skos:prefLabel xml:lang="en">produced by</skos:prefLabel>
        <skos:definition xml:lang="en">Links a document or product to the process that created it.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#produces"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessDocument"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#hasInput">
        <rdfs:label xml:lang="en">has input</rdfs:label>
        <skos:prefLabel xml:lang="en">has input</skos:prefLabel>
        <skos:definition xml:lang="en">Links a process to a document or product that it needs in order to run.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#inputOf"/>
        <rdfs:domain rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessDocument"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#inputOf">
        <rdfs:label xml:lang="en">input of</rdfs:label>
        <skos:prefLabel xml:lang="en">input of</skos:prefLabel>
        <skos:definition xml:lang="en">Links a document or product to a process that needs it.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#hasInput"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessDocument"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/ontology/business#BusinessProcess"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#basedOn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label xml:lang="en">based on</rdfs:label>
        <skos:prefLabel xml:lang="en">based on</skos:prefLabel>
        <skos:definition xml:lang="en">Links a document to an earlier document that it was prepared from.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#basisFor"/>
        <rdfs:domain rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <rdfs:range rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#basisFor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label xml:lang="en">basis for</rdfs:label>
        <skos:prefLabel xml:lang="en">basis for</skos:prefLabel>
        <skos:definition xml:lang="en">Links a document to a later document that was prepared from it.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#basedOn"/>
        <rdfs:domain rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <rdfs:range rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#issuedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">issued by</rdfs:label>
        <skos:prefLabel xml:lang="en">issued by</skos:prefLabel>
        <skos:definition xml:lang="en">Links a document to the person or organization that issued it.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#issues"/>
        <rdfs:domain rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#Person"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#issues">
        <rdfs:label xml:lang="en">issues</rdfs:label>
        <skos:prefLabel xml:lang="en">issues</skos:prefLabel>
        <skos:definition xml:lang="en">Links a person or organization to a document it issued.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#issuedBy"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#Person"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/ontology/business#BusinessDocument"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#governedBy">
        <rdfs:label xml:lang="en">governed by</rdfs:label>
        <skos:prefLabel xml:lang="en">governed by</skos:prefLabel>
        <skos:definition xml:lang="en">Links a process or document to a policy or rule that controls it.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#governs"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessProcess"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessDocument"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#Policy"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessRule"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Regulation"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Contract"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#governs">
        <rdfs:label xml:lang="en">governs</rdfs:label>
        <skos:prefLabel xml:lang="en">governs</skos:prefLabel>
        <skos:definition xml:lang="en">Links a policy, rule, regulation or contract to a process or document it controls.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#governedBy"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#Policy"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessRule"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Regulation"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Contract"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessProcess"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessDocument"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#locatedAt">
        <rdfs:label xml:lang="en">located at</rdfs:label>
        <skos:prefLabel xml:lang="en">located at</skos:prefLabel>
        <skos:definition xml:lang="en">Links an organization or facility to the location where it is.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#locationOf"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000171"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#Organization"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Facility"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://example.org/ontology/business#Location"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#locationOf">
        <rdfs:label xml:lang="en">location of</rdfs:label>
        <skos:prefLabel xml:lang="en">location of</skos:prefLabel>
        <skos:definition xml:lang="en">Links a location to an organization or facility that is there.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#locatedAt"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000124"/>
        <rdfs:domain rdf:resource="http://example.org/ontology/business#Location"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#Organization"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Facility"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#hasAttribute">
        <rdfs:label xml:lang="en">has attribute</rdfs:label>
        <skos:prefLabel xml:lang="en">has attribute</skos:prefLabel>
        <skos:definition xml:lang="en">Links a business entity to one of its attributes. For documents, treat it as an association and not as a BFO inherence relation.</skos:definition>
        <owl:inverseOf rdf:resource="http://example.org/ontology/business#attributeOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="http://example.org/ontology/business#Organization"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Person"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Product"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#Facility"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessDocument"/>
                <rdf:Description rdf:about="http://example.org/ontology/business#BusinessProcess"/>
