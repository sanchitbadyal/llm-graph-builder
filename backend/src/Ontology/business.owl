                <rdf:Description rdf:about="http://example.org/ontology/business#Organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/business#participantIn">
        <rdfs:label xml:lang="en">participant in</rdfs:label>
        <skos:prefLabel xml:lang="en">participant in</skos:prefLabel>
